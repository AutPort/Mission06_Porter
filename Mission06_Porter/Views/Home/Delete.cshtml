@{
}

@model Movie

<h2>Confirm Deletion</h2><br />

<h3>Delete "@Model.Title" directed by @Model.Director, @Model.Year?</h3><br /> <!-- display which record they have selected to delete -->

<form method="post">

    <input type="hidden" asp-for="MovieId" />

    <!-- buttons to confirm deletion or cancel -->
    <button class="btn-danger" type="submit">Delete</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="MovieList">Cancel</a>

</form>